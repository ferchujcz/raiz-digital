---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Services from '../components/Services.astro';
import Standards from '../components/Standards.astro';
import Portfolio from '../components/Portfolio.astro';
import Contact from '../components/Contact.astro';
---

<Layout 
    title="Raíz Digital | Desarrollo de Software a Medida y Sistemas Web"
    description="Empresa de desarrollo de software a medida, sistemas web y automatización de procesos. Soluciones digitales para empresas en Misiones y toda Argentina."
>
    <Header />
    <main>
        <Hero />
        <TrustBar />
        <Services />
        <Standards />
        <Portfolio />
        <Contact />
    </main>

    <footer class="border-t border-white/10 bg-[#050505] py-8 text-center text-gray-500 text-sm">
      <div class="container mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4">
        <p>&copy; {new Date().getFullYear()} Raíz Digital. Todos los derechos reservados.</p>
        <div class="flex gap-4">
          <a href="https://www.linkedin.com/in/fernando-czaban-b339642a6" target="_blank" rel="noopener noreferrer" class="hover:text-[#00FF85] transition-colors">LinkedIn</a>
        </div>
      </div>
    </footer>
</Layout>