---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Services from '../components/Services.astro';
import Portfolio from '../components/Portfolio.astro';
import Contact from '../components/Contact.astro';
---

<Layout>
  <main>
    <Hero />
    <TrustBar />
    <Services />
    <Portfolio />
    <Contact />
  </main>
  
  <footer class="border-t border-white/10 bg-[#050505] py-8 text-center text-gray-500 text-sm">
    <div class="container mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <p>&copy; {new Date().getFullYear()} Raíz Digital. Todos los derechos reservados.</p>
      <div class="flex gap-4">
        <a href="#" class="hover:text-[#00FF85] transition-colors">LinkedIn</a>
        <a href="#" class="hover:text-[#00FF85] transition-colors">GitHub</a>
      </div>
    </div>
  </footer>
</Layout>