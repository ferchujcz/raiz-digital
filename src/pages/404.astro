---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada | Raíz Digital" description="Error 404">
    <main class="min-h-screen flex flex-col items-center justify-center text-center px-6">
        <h1 class="text-9xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-emerald-600 mb-4">404</h1>
        <h2 class="text-3xl font-bold text-white mb-4">Oops, nos perdimos en el código.</h2>
        <p class="text-gray-400 mb-8 max-w-md">La página que estás buscando no existe, fue movida o el enlace está roto.</p>
        <a href="/" class="bg-emerald-500 hover:bg-emerald-400 text-black font-bold py-3 px-8 rounded-full transition-colors duration-300">
            Volver al inicio
        </a>
    </main>
</Layout>