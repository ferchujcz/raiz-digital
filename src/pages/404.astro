---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada | Raíz Digital" description="Error 404" noindex={true}>
    <main class="min-h-screen flex flex-col items-center justify-center text-center px-6">
        <h1 class="text-9xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-[#22C55E] to-[#16A34A] mb-4">404</h1>
        <h2 class="text-3xl font-bold text-[#F5F5F5] mb-4">Oops, nos perdimos en el código.</h2>
        <p class="text-[#A1A1AA] mb-8 max-w-md">La página que estás buscando no existe, fue movida o el enlace está roto.</p>
        <a href="/" class="bg-[#22C55E] hover:bg-[#16A34A] text-black font-bold py-3 px-8 rounded-full transition-all duration-300 shadow-[0_0_20px_rgba(34,197,94,0.2)] hover:shadow-[0_0_25px_rgba(34,197,94,0.35)]">
            Volver al inicio
        </a>
    </main>
</Layout>