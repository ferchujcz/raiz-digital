---
---
<header class="fixed top-0 w-full z-50 bg-[#0A0A0A]/80 backdrop-blur-md border-b border-[#18181B]">
  <div class="container mx-auto px-6 h-20 flex items-center justify-between">
    <a href="/" class="text-2xl font-black tracking-tighter text-[#F5F5F5]">
      RAÍZ<span class="text-[#22C55E]">.</span>
    </a>
    
    <nav class="hidden lg:flex gap-7 text-sm font-bold text-[#A1A1AA] items-center">
      <a href="/servicios/desarrollo-software-a-medida" class="hover:text-[#F5F5F5] transition-colors">Software a Medida</a>
      <a href="/servicios/desarrollo-web" class="hover:text-[#F5F5F5] transition-colors">Desarrollo Web</a>
      <a href="/#proyectos" class="hover:text-[#F5F5F5] transition-colors">Portafolio</a>
      <a href="/contacto" class="hover:text-[#F5F5F5] transition-colors">Contacto</a>
      <a href="https://www.linkedin.com/in/fernando-czaban-b339642a6" target="_blank" rel="noopener noreferrer" class="hover:text-[#22C55E] transition-colors">LinkedIn</a>
    </nav>

    <button id="menu-btn" class="lg:hidden text-[#F5F5F5] p-2" aria-label="Menú">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
    </button>

    <a href="/contacto" class="hidden lg:block bg-[#22C55E] hover:bg-[#16A34A] text-black px-6 py-2.5 rounded-full font-bold transition-all hover:scale-105 text-sm shadow-[0_0_15px_rgba(34,197,94,0.2)]">
      Consulta Directa
    </a>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden bg-[#111111] border-b border-[#18181B] p-6 space-y-4">
    <a href="/servicios/desarrollo-software-a-medida" class="block text-[#A1A1AA] font-bold hover:text-[#22C55E]">Software a Medida</a>
    <a href="/servicios/desarrollo-web" class="block text-[#A1A1AA] font-bold hover:text-[#22C55E]">Desarrollo Web</a>
    <a href="/#proyectos" class="block text-[#A1A1AA] font-bold hover:text-[#22C55E]">Portafolio</a>
    <a href="/contacto" class="block text-[#A1A1AA] font-bold hover:text-[#22C55E]">Contacto</a>
    <a href="https://www.linkedin.com/in/fernando-czaban-b339642a6" target="_blank" rel="noopener noreferrer" class="block text-[#A1A1AA] font-bold hover:text-[#22C55E]">LinkedIn</a>
    <a href="/contacto" class="block text-[#22C55E] font-bold mt-4">Consulta Directa</a>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>