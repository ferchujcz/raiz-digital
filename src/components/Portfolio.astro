---
// src/components/Portfolio.astro
---
<section id="proyectos" class="py-24 px-6 container mx-auto">
    <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 reveal">Casos de Éxito</h2>
        <p class="text-gray-400 reveal">Sistemas reales funcionando actualmente.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- PROYECTO 1: Enlace a tu página stock.astro -->
        <a href="/proyectos/stock" class="block group reveal">
            <div class="bg-[#0A0A0A] border border-white/10 rounded-3xl overflow-hidden hover:border-emerald-500 transition-all duration-300 transform group-hover:-translate-y-2">
                <div class="aspect-video bg-gradient-to-br from-emerald-900 to-[#0A0A0A] relative flex items-center justify-center">
                    <span class="text-emerald-500/50 text-5xl group-hover:scale-110 transition-transform"><i class="fas fa-boxes"></i></span>
                    <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
                        <span class="text-emerald-400 font-bold tracking-widest uppercase text-sm border border-emerald-400 px-4 py-2 rounded-full">Ver Análisis</span>
                    </div>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-white mb-2">ERP Stock Inteligente</h3>
                    <p class="text-sm text-gray-400 mb-4">Predicción de compras con IA, facturación OCR y control total.</p>
                    <div class="flex gap-2">
                        <span class="text-xs bg-emerald-500/10 text-emerald-400 px-2 py-1 rounded">Python</span>
                        <span class="text-xs bg-emerald-500/10 text-emerald-400 px-2 py-1 rounded">PostgreSQL</span>
                    </div>
                </div>
            </div>
        </a>

        <!-- PROYECTO 2 (Próximamente / Ejemplo) -->
        <div class="block group reveal delay-100 cursor-not-allowed opacity-80">
            <div class="bg-[#0A0A0A] border border-white/10 rounded-3xl overflow-hidden">
                <div class="aspect-video bg-[#111] relative flex items-center justify-center">
                    <span class="text-gray-700 font-bold">PRÓXIMAMENTE</span>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-white mb-2">Automatización Low-Code</h3>
                    <p class="text-sm text-gray-400 mb-4">Gestión ágil con herramientas de Google Workspace.</p>
                </div>
            </div>
        </div>

    </div>
</section>