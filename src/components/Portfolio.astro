---
// src/components/Portfolio.astro
---
<section id="proyectos" class="py-24 px-6 container mx-auto">
    <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-[#F5F5F5] mb-4 reveal">Sistemas en Producción y Casos de Estudio Reales</h2>
        <p class="text-[#A1A1AA] reveal">Sistemas reales funcionando actualmente.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- PROYECTO 1: Enlace al caso de estudio ERP -->
        <a href="/proyectos/erp-gestion-stock" class="block group reveal">
            <div class="bg-[#111111] border border-[#18181B] rounded-3xl overflow-hidden hover:border-[#22C55E] transition-all duration-300 transform group-hover:-translate-y-2">
                <div class="aspect-video bg-gradient-to-br from-[#15803D]/40 to-[#0A0A0A] relative flex items-center justify-center">
                    <span class="text-[#22C55E]/50 text-5xl group-hover:scale-110 transition-transform"><i class="fas fa-boxes"></i></span>
                    <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity">
                        <span class="text-[#22C55E] font-bold tracking-widest uppercase text-sm border border-[#22C55E] px-4 py-2 rounded-full">Ver Análisis</span>
                    </div>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-[#F5F5F5] mb-2">ERP Stock Inteligente</h3>
                    <p class="text-sm text-[#A1A1AA] mb-4">Predicción de compras con IA, facturación OCR y control total.</p>
                    <div class="flex gap-2">
                        <span class="text-xs bg-[#22C55E]/10 text-[#22C55E] px-2 py-1 rounded">Python</span>
                        <span class="text-xs bg-[#22C55E]/10 text-[#22C55E] px-2 py-1 rounded">PostgreSQL</span>
                    </div>
                </div>
            </div>
        </a>

        <!-- PROYECTO 2 (Próximamente / Ejemplo) -->
        <div class="block group reveal delay-100 cursor-not-allowed opacity-80">
            <div class="bg-[#111111] border border-[#18181B] rounded-3xl overflow-hidden">
                <div class="aspect-video bg-[#18181B] relative flex items-center justify-center">
                    <span class="text-[#A1A1AA] font-bold">PRÓXIMAMENTE</span>
                </div>
                <div class="p-6">
                    <h3 class="text-xl font-bold text-[#F5F5F5] mb-2">Automatización Low-Code</h3>
                    <p class="text-sm text-[#A1A1AA] mb-4">Gestión ágil con herramientas de Google Workspace.</p>
                </div>
            </div>
        </div>

    </div>
</section>